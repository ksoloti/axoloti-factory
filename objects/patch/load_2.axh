<patch-1.0 appVersion="1.2.0">
  <comment type="patch/comment" x="14" y="14" text="&lt;html&gt;&lt;h3&gt;Upload both this patch (load_2.axh) and load.axh to SD card &lt;i&gt;(Patch -&gt; Upload to SD Card)&lt;/i&gt;&lt;br&gt;While patch is live, press button S1 to load the other patch (as is specified in the below patch/load object)"/>
  <comment type="patch/comment" x="14" y="98" text="Saw wave through filter"/>
  <obj type="osc/saw" uuid="739ecc36017ef3249479b8f01716b8bbfba9abc1" name="osc_1" x="14" y="112">
    <params>
      <frac32.s.map name="pitch" value="-12.0"/>
    </params>
    <attribs/>
  </obj>
  <obj type="filter/lp1" uuid="1b1fd7085e44d2b7b80b59b8d68796b909c1b2cc" name="lp1_1" x="126" y="112">
    <params>
      <frac32.s.map name="freq" value="0.0"/>
    </params>
    <attribs/>
  </obj>
  <obj type="audio/out stereo" uuid="a1ca7a567f535acc21055669829101d3ee7f0189" name="out stereo_1" x="266" y="112">
    <params/>
    <attribs/>
  </obj>
  <obj type="gpio/in/button1" uuid="2f4fbacf3969a3a1ff9d23899566430051cb01f" name="button11" x="14" y="210">
    <params/>
    <attribs/>
  </obj>
  <obj type="patch/load" uuid="634bf1f8c313920d7f19fc402ba937fd1ee27802" name="load_1" x="126" y="210">
    <params/>
    <attribs>
      <table attributeName="filename" table="/load/patch.bin"/>
    </attribs>
  </obj>
  <nets>
    <net>
      <source obj="button11" outlet="out"/>
      <dest obj="load_1" inlet="trig"/>
    </net>
    <net>
      <source obj="osc_1" outlet="wave"/>
      <dest obj="lp1_1" inlet="in"/>
    </net>
    <net>
      <source obj="lp1_1" outlet="out"/>
      <dest obj="out stereo_1" inlet="left"/>
      <dest obj="out stereo_1" inlet="right"/>
    </net>
  </nets>
  <settings>
    <subpatchmode>no</subpatchmode>
  </settings>
  <notes><![CDATA[]]></notes>
  <windowPos>
    <x>61</x>
    <y>0</y>
    <width>610</width>
    <height>422</height>
  </windowPos>
</patch-1.0>