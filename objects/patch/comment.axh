<patch-1.0 appVersion="1.1.0">
  <comment type="patch/comment" x="28" y="14" text="&lt;html&gt;&lt;h1&gt;Drop a &apos;patch/comment&apos; object or press SHIFT+C to create a comment."/>
  <comment type="patch/comment" x="28" y="56" text="Write text inside the label to annotate your patches. Double-click on an existing comment to edit it."/>
  <comment type="patch/comment" x="28" y="84" text="&lt;html&gt;You can move and edit comments while your patch is live&lt;br&gt;but you can only &lt;b&gt;add comments&lt;/b&gt; while the patch is stopped."/>
  <comment type="patch/comment" x="28" y="140" text="&lt;html&gt;&lt;h1&gt;Comments support some basic html."/>
  <comment type="patch/comment" x="28" y="182" text="&lt;html&gt;Write a &lt;b&gt;&amp;lt;html&amp;gt;&lt;/b&gt; tag anywhere to enable html from that position on."/>
  <comment type="patch/comment" x="28" y="210" text="&lt;html&gt;&lt;h1&gt;Here&apos;s some text in a &amp;lt;h1&amp;gt; tag!&lt;/h1&gt; Double-click on me to see the html!"/>
  <comment type="patch/comment" x="28" y="294" text="&lt;html&gt;No one really knows what exact tags are supported, but rumour has it that it supports HTML 3.2. Whatever that means.&lt;br&gt;Writing complex html inside this comment editor thing is a bit painful, consider editing in a text editor then pasting back into the comment.&lt;ul&gt;&lt;li&gt;List tags are supported.&lt;/li&gt;&lt;li&gt;&lt;b&gt;bold&lt;/b&gt;, &lt;i&gt;italic&lt;/i&gt;, &lt;u&gt;underscore&lt;/u&gt;&lt;/li&gt;&lt;li&gt;&amp;lt;p&amp;gt;, &amp;lt;span&amp;gt;, &amp;lt;br&amp;gt; and such stuff&lt;/li&gt;&lt;li&gt;&amp;lt;div style=&quot;&quot;&amp;gt; and &amp;lt;span style=&quot;&quot;&amp;gt; - &lt;span style=&quot;font-family:serif; color:#ABCDEF;&quot;&gt;See example below&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Different font sizes, font families, color, background color etc.&lt;/li&gt;&lt;li style=&quot;font:Arial;&quot;&gt;Specifying fonts is supported but the font may not be available on other people&apos;s computers.&lt;/li&gt;&lt;li&gt;Embedding images using &amp;lt;img src=&quot;&quot;&amp;gt; does work, however only with absolute path?&lt;/li&gt;&lt;li&gt;Tables! (Though painful to style)&lt;table style=&quot;border: 1px solid #ddd;&quot;&gt;   &lt;tr style=&quot;border: 1px solid #ddd;&quot;&gt;     &lt;th&gt;Company&lt;/th&gt;     &lt;th&gt;Contact&lt;/th&gt;     &lt;th&gt;Country&lt;/th&gt;   &lt;/tr&gt;   &lt;tr style=&quot;border: 1px solid #ddd;&quot;&gt;     &lt;td&gt;Alfreds Futterkiste&lt;/td&gt;     &lt;td&gt;Maria Anders&lt;/td&gt;     &lt;td&gt;Germany&lt;/td&gt;   &lt;/tr&gt;   &lt;tr style=&quot;border: 1px solid #ddd;&quot;&gt;     &lt;td&gt;Centro comercial Moctezuma&lt;/td&gt;     &lt;td&gt;Francisco Chang&lt;/td&gt;     &lt;td&gt;Mexico&lt;/td&gt;   &lt;/tr&gt; &lt;/table&gt;&lt;/li&gt;&lt;/ul&gt;"/>
  <comment type="patch/comment" x="28" y="560" text="&lt;html&gt;&lt;h3&gt;By the way, for links use the dedicated &apos;patch/hyperlink&apos; object. You can both link local files and web links."/>
  <hyperlink type="patch/hyperlink" name="https://www.example.com" x="28" y="602"/>
  <comment type="patch/comment" x="28" y="658" text="Here&apos;s some boring text without html tag (yet!) &lt;html&gt;&lt;div style=&quot;font-size: 96px; color: #FF8040; font-family: monospace;&quot;&gt;And here comes some fun html styling!&lt;span style=&quot;font-size: 48px; color: #FF4080; font-family: serif; background-color:#123456;&quot;&gt;Wow&lt;/span&gt;&lt;/div&gt;"/>
  <nets/>
  <settings>
    <subpatchmode>no</subpatchmode>
  </settings>
  <notes><![CDATA[]]></notes>
  <windowPos>
    <x>100</x>
    <y>100</y>
    <width>790</width>
    <height>928</height>
  </windowPos>
</patch-1.0>